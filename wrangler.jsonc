{
  "name": "personal-page",
  "account_id": "a3fc82747e6f245782f0d7fd41b7b4ba",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    // Serve leothe.dev from Cloudflare's edge instead of the Raspberry Pi.
    // Routes take precedence over the tunnel's DNS records, so nothing in DNS
    // changes. Switch on:  bun run deploy:edge
    // Switch back to Pi:   bunx wrangler delete --env edge
    "edge": {
      "workers_dev": false,
      "routes": [
        { "pattern": "leothe.dev/*", "zone_name": "leothe.dev" },
        { "pattern": "www.leothe.dev/*", "zone_name": "leothe.dev" }
      ]
    }
  }
}
